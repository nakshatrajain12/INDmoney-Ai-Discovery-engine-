# ==============================================================================
# AI Discovery Engine - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# DO NOT commit .env to version control!
# ==============================================================================

# LLM Providers (Configure at least one)
# Claude (Default recommended for extraction: Claude 3.5 Haiku + Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (For embeddings: text-embedding-3-small or GPT-4o fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (Ultra-fast inference & fallback key rotation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Scrapers Configuration
# Reddit API (Optional - official PRAW application credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=INDmoneySIPResearch/1.0

# YouTube Data API v3 (Optional for comments scraper)
YOUTUBE_API_KEY=
