  "description": "Deterministic debit failure diagnostic matrix covering 7 categories per architecture.md Section 4.2",
  "rules": [
    {
      "category": "UPI_DAILY_LIMIT",
      "ruleId": "DE-RULE-001",
      "providerCodes": [
        "UPI_DAILY_LIMIT",
        "MOCK_UPI_DAILY_LIMIT_EXCEEDED",
        "UPI_LIMIT_EXCEEDED",
        "PSP_UPI_LIMIT",
        "DAILY_LIMIT_REACHED"
      ],
      "humanReason": "Your bank's UPI daily transaction limit was reached on the debit date.",
      "sipStatusImpact": "Active · 1 failed instalment",
      "sipStatusDetail": "Your SIP remains active. Missing an instalment does not pause or cancel your ongoing SIP schedule.",
      "statusChip": {
        "label": "Active · 1 failed instalment",
        "variant": "amber",
        "icon": "alert"
      },
      "isSipActive": true,
      "isMandateActive": true,
      "isMandateRevoked": false,
      "retryAllowed": true,
      "autoRetryExpected": false,
      "nextAction": {
        "type": "RETRY_MANUAL",
        "label": "Pay manually now",
        "buttonText": "Pay {{amount}} manually now"
      },
      "secondaryAction": {
        "type": "WAIT_NEXT",
        "label": "Wait for next scheduled debit"
      },
      "consequenceNotice": null
    },
