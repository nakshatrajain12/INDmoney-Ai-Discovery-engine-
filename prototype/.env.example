# SIP Steady: environment template.
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# These variables are read on the SERVER only. Never prefix a secret with NEXT_PUBLIC_.

APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error

# Demo tools (right-hand demo panel, demo clock). Keep true for the prototype.
DEMO_PANEL=true

# LLM rephrasing is OPTIONAL and OFF by default. The product works fully on templates.
# If LLM_ENABLED=true, provider, model and key are all required (validated at startup).
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Reserved for a later phase (persistent store). Not used in Phase 0.
# DATABASE_URL=
